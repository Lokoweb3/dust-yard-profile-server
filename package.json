{
  "name": "dust-yard-profile-server",
  "version": "1.0.0",
  "private": true,
  "description": "Mints and updates soulbound Dust Yard profile NFTs on X1",
  "main": "profile-server.js",
  "scripts": {
    "start": "node profile-server.js",
    "dry-run": "node profile-server.js --dry-run",
    "check": "node scripts/check-repo.mjs",
    "test:smoke": "node tests/smoke.mjs",
    "test:e2e": "node tests/e2e.mjs",
    "test": "npm run check && npm run lint && npm run test:smoke && npm run test:e2e",
    "lint": "eslint --no-eslintrc --env node,es2022 --parser-options=ecmaVersion:2022 --rule 'no-undef:error' profile-server.js lib/",
    "build": "node scripts/build-game.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@metaplex-foundation/mpl-token-metadata": "3.3.0",
    "@metaplex-foundation/umi": "0.9.2",
    "@metaplex-foundation/umi-bundle-defaults": "0.9.2",
    "@solana/spl-token": "0.4.9",
    "@solana/spl-token-metadata": "0.1.6",
    "@solana/web3.js": "1.95.8",
    "bs58": "5.0.0",
    "tweetnacl": "1.0.3",
    "ws": "8.18.0"
  },
  "devDependencies": {
    "esbuild": "0.24.0",
    "eslint": "8.57.0",
    "playwright": "1.55.0",
    "three": "0.128.0"
  }
}
